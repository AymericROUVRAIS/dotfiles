/**
 * Author : Aymeric Rouvrais
 * Desc : Horizontal window on the top left
 * From : dmenu by QBall
 */

@import "catppuccin_macchiato"

window {
  anchor:       north;
  location:     north;
  width:        100%;
  padding:      5px;
  border:       1px;
  border-color: @bg2;
  children:   [ horibox ];
}

horibox {
  orientation: horizontal;
  children:   [ entry, listview ];
}

listview {
  layout:     horizontal;
  spacing:    5px;
  lines:      100;
}

entry {
  expand:     false;
  width:      3em;
}

element {
  padding: 4px 8px;
  spacing: 8px;
}

element {
  padding: 0px 2px;
}

element selected {
  text-color       : @bg1;
  background-color : @accent;
}

element normal urgent {
  text-color: @urgent;
}

element normal active, element alternative active {
  text-color: @accent;
}

element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}
